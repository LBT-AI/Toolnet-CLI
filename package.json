{
  "name": "toolnetcli",
  "version": "1.2.2",
  "type": "module",
  "license": "MIT",
  "description": "ToolNet CLI — AI coding agent for the terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBT-AI/Toolnet-CLI.git"
  },
  "homepage": "https://github.com/LBT-AI/Toolnet-CLI",
  "bugs": {
    "url": "https://github.com/LBT-AI/Toolnet-CLI/issues"
  },
  "bin": {
    "toolnet": "bin/toolnet.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun src/index.tsx",
    "build:bun": "bun build src/index.tsx --target=bun --outdir=dist",
    "build:node": "bun build src/index.tsx --target=node --outdir=dist/node",
    "build": "bun run build:bun && bun run build:node",
    "prepack": "bun run build",
    "start": "bun dist/index.js",
    "start:node": "node dist/node/index.js",
    "dev:boot": "tsx toolnet-cli.ts",
    "build:boot": "tsc -p tsconfig.toolnet-cli.json",
    "start:boot": "node dist/toolnet-cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "pack:cli": "npm pack",
    "publish:cli": "npm publish",
    "build:bin": "bun build src/index.tsx --compile --outfile dist-bin/toolnet",
    "build:bin:linux-x64": "bun build src/index.tsx --compile --target=bun-linux-x64 --outfile dist-bin/toolnet-linux-x64",
    "build:bin:linux-arm64": "bun build src/index.tsx --compile --target=bun-linux-arm64 --outfile dist-bin/toolnet-linux-arm64",
    "build:bin:darwin-x64": "bun build src/index.tsx --compile --target=bun-darwin-x64 --outfile dist-bin/toolnet-darwin-x64",
    "build:bin:darwin-arm64": "bun build src/index.tsx --compile --target=bun-darwin-arm64 --outfile dist-bin/toolnet-darwin-arm64",
    "build:bin:win-x64": "bun build src/index.tsx --compile --target=bun-windows-x64 --outfile dist-bin/toolnet-windows-x64.exe"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^6.0.0",
    "log-update": "^8.0.0",
    "string-width": "^8.2.2",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.4.0",
    "solid-js": "1.9.12",
    "tsx": "^4.23.13",
    "typescript": "5.8.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "babel-plugin-module-resolver": {
      "glob": "13.0.6"
    }
  }
}

{
  "name": "toolnetcli",
  "version": "1.0.5",
  "type": "module",
  "license": "MIT",
  "description": "ToolNet CLI — AI coding agent for the terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBT-AI/Toolnet-CLI.git"
  },
  "homepage": "https://github.com/LBT-AI/Toolnet-CLI",
  "bugs": {
    "url": "https://github.com/LBT-AI/Toolnet-CLI/issues"
  },
  "bin": {
    "toolnet": "bin/toolnet.js",
    "toolnetcli": "bin/toolnet.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun src/index.tsx",
    "build:bun": "bun build src/index.tsx --target=bun --outdir=dist",
    "build:node": "bun build src/index.tsx --target=node --outdir=dist/node",
    "build": "bun run build:bun && bun run build:node",
    "prepack": "bun run build",
    "start": "bun dist/index.js",
    "start:node": "node dist/node/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "pack:cli": "npm pack",
    "publish:cli": "npm publish"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "opentui-spinner": "0.0.7",
    "solid-js": "1.9.10",
    "string-width": "^8.2.2",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.8.2"
  }
}
